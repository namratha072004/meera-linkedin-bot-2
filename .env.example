# From @BotFather
TELEGRAM_BOT_TOKEN=
# From aistudio.google.com/apikey (used for transcription and drafting)
GEMINI_API_KEY=
# Any long random string. Telegram sends it with every message so the
# Vercel endpoint can reject requests that didn't come from Telegram.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

